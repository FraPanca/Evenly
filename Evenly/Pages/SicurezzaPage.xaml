<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Evenly.Pages.GestoreSicurezzaPage"
             Title="Dashboard Sicurezza"
             BackgroundColor="{StaticResource PageBg}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Logout" Clicked="OnLogoutClicked"/>
        <ToolbarItem Text="Aggiorna" Clicked="OnAggiornaDatiClicked"/>
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="20,16" Spacing="16">

            <Label Text="Dashboard Sicurezza" FontSize="20" FontAttributes="Bold"
                   TextColor="#6E88ED"/>

            <!-- Utenti registrati -->
            <Label Text="Utenti registrati" FontSize="16" FontAttributes="Bold"
                   TextColor="#E8F0FE" Margin="0,8,0,0"/>

            <CollectionView x:Name="UtentiCollection" HeightRequest="220">
                <CollectionView.EmptyView>
                    <Label Text="Nessun utente." TextColor="#8099B8" FontAttributes="Italic"/>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*,Auto,Auto" Padding="4,8"
                              ColumnSpacing="12">
                            <VerticalStackLayout Spacing="1">
                                <Label FontSize="14" FontAttributes="Bold"
                                       Text="{Binding Username}" TextColor="#E8F0FE"/>
                                <Label FontSize="12" TextColor="#8099B8">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Nome}"/>
                                            <Span Text=" "/>
                                            <Span Text="{Binding Cognome}"/>
                                            <Span Text=" — "/>
                                            <Span Text="{Binding Email}"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>
                            <Label Grid.Column="2" FontSize="12" VerticalOptions="Center"
                                   Text="{Binding Stato}" TextColor="#8099B8"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Log di sistema -->
            <BoxView HeightRequest="1" Color="#253550" Margin="0,4"/>

            <Label Text="Log di sistema" FontSize="16" FontAttributes="Bold"
                   TextColor="#E8F0FE"/>
            <Label x:Name="LogCountLabel" FontSize="12" TextColor="#8099B8"/>

            <CollectionView x:Name="LogCollection" HeightRequest="500">
                <CollectionView.EmptyView>
                    <Label Text="Nessuna voce nel log." TextColor="#8099B8"
                           FontAttributes="Italic" Margin="0,12"/>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout Padding="4,6" Spacing="2">
                            <Label FontSize="13">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding Utente}" FontAttributes="Bold"
                                              TextColor="#6E88ED"/>
                                        <Span Text=" · "/>
                                        <Span Text="{Binding Operazione}" FontAttributes="Bold"
                                              TextColor="#E8F0FE"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label FontSize="12" TextColor="#8099B8">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding Timestamp, StringFormat='{0:dd/MM/yyyy HH:mm:ss}'}"/>
                                        <Span Text=" — "/>
                                        <Span Text="{Binding Dettaglio}"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <BoxView HeightRequest="1" Color="#253550"/>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
