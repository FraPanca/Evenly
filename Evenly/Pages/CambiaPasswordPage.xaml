<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Evenly.Pages.CambiaPasswordPage"
             Title="Cambia Password"
             BackgroundColor="{StaticResource PageBg}">

    <ScrollView>
        <VerticalStackLayout Padding="24,20" Spacing="14">

            <Label Text="Cambia password" FontSize="20" FontAttributes="Bold"
                   TextColor="#6E88ED" Margin="0,0,0,8"/>

            <Label Text="Password corrente" FontSize="13" TextColor="#8099B8"/>
            <Entry x:Name="VecchiaPasswordEntry" IsPassword="True"
                   Placeholder="Inserisci la password attuale"/>

            <Label Text="Nuova password" FontSize="13" TextColor="#8099B8"/>
            <Entry x:Name="NuovaPasswordEntry" IsPassword="True"
                   Placeholder="Minimo 6 caratteri"/>

            <Label Text="Conferma nuova password" FontSize="13" TextColor="#8099B8"/>
            <Entry x:Name="ConfermaPasswordEntry" IsPassword="True"
                   Placeholder="Ripeti la nuova password"/>

            <Button x:Name="CambiaBtn" Text="Cambia password"
                    BackgroundColor="#6E88ED" TextColor="#0F172A"
                    Clicked="OnCambiaPasswordClicked" Margin="0,8,0,0"/>

            <Label x:Name="ErrorLabel" TextColor="#F87171" IsVisible="False"/>
            <Label x:Name="SuccessLabel" TextColor="#78D7C1" IsVisible="False"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
