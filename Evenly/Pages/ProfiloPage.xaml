<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Evenly.Pages.ProfiloPage"
             Title="Il mio profilo"
             BackgroundColor="{StaticResource PageBg}">

    <ScrollView>
        <VerticalStackLayout Padding="24,20" Spacing="12">

            <Label Text="Username" FontSize="13" TextColor="#8099B8"/>
            <Label x:Name="UsernameLabel" FontSize="16" FontAttributes="Bold" TextColor="#6E88ED"/>

            <Label Text="Nome" FontSize="13" TextColor="#8099B8"/>
            <Entry x:Name="NomeEntry"/>

            <Label Text="Cognome" FontSize="13" TextColor="#8099B8"/>
            <Entry x:Name="CognomeEntry"/>

            <Label Text="Email" FontSize="13" TextColor="#8099B8"/>
            <Entry x:Name="EmailEntry" Keyboard="Email"/>

            <Label Text="Valuta predefinita" FontSize="13" TextColor="#8099B8"/>
            <Entry x:Name="ValutaEntry" Placeholder="EUR"/>

            <Button Text="Salva modifiche" BackgroundColor="#6E88ED" TextColor="#0F172A"
                    Clicked="OnSalvaClicked" Margin="0,12,0,0"/>

            <Button Text="Cambia password" BackgroundColor="#253550" TextColor="#E8F0FE"
                    Clicked="OnCambiaPasswordClicked"/>

            <Label x:Name="ErrorLabel" TextColor="#F87171" IsVisible="False"/>

            <BoxView HeightRequest="1" Color="#253550" Margin="0,16"/>

            <Button Text="Elimina account" BackgroundColor="#DC2626" TextColor="White"
                    Clicked="OnEliminaAccountClicked"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
