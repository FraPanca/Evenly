<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Evenly.Pages.AccediGruppoPage"
             Title="Accedi a Gruppo"
             BackgroundColor="{StaticResource PageBg}">

    <ScrollView>
        <VerticalStackLayout Padding="40,30" Spacing="14">

            <Label Text="Accedi a un gruppo" FontSize="22"
                   FontAttributes="Bold" TextColor="#6E88ED" Margin="0,0,0,10"/>

            <!-- Sezione credenziali -->
            <Label Text="Tramite ID + Password" FontAttributes="Bold"
                   FontSize="15" TextColor="#E8F0FE"/>

            <Label Text="ID del gruppo" FontSize="13" TextColor="#8099B8"/>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry Grid.Column="0" x:Name="GroupIdEntry"
                       Placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"/>
                <Button Grid.Column="1" Text="Incolla" BackgroundColor="#10192A"
                        TextColor="#E8F0FE" Clicked="OnIncollaIdClicked"
                        Padding="10,0"/>
            </Grid>

            <Label Text="Password del gruppo" FontSize="13" TextColor="#8099B8"/>
            <Entry x:Name="PasswordEntry" Placeholder="Password" IsPassword="True"/>

            <Button x:Name="AccediBtn" Text="Accedi con credenziali"
                    BackgroundColor="#6E88ED" TextColor="#0F172A"
                    Clicked="OnAccediClicked"/>

            <!-- Separatore -->
            <BoxView HeightRequest="1" Color="#253550" Margin="0,8"/>

            <!-- Sezione link di invito -->
            <Label Text="Tramite link di invito" FontAttributes="Bold"
                   FontSize="15" TextColor="#E8F0FE"/>

            <Label Text="Token di invito" FontSize="13" TextColor="#8099B8"/>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry Grid.Column="0" x:Name="TokenEntry"
                       Placeholder="Incolla il token ricevuto"/>
                <Button Grid.Column="1" Text="Incolla" BackgroundColor="#10192A"
                        TextColor="#E8F0FE" Clicked="OnIncollaTokenClicked"
                        Padding="10,0"/>
            </Grid>

            <Button x:Name="AccediLinkBtn" Text="Accedi con link"
                    BackgroundColor="#78D7C1" TextColor="#0F172A"
                    Clicked="OnAccediConLinkClicked"/>

            <Label x:Name="ErrorLabel" TextColor="#F87171" IsVisible="False"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
