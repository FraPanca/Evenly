<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Evenly.Pages.CreaGruppoPage"
             Title="Crea Gruppo"
             BackgroundColor="{StaticResource PageBg}">

    <ScrollView>
        <VerticalStackLayout Padding="40,30" Spacing="14">

            <Label Text="Crea un nuovo gruppo" FontSize="22"
                   FontAttributes="Bold" TextColor="#6E88ED" Margin="0,0,0,10"/>

            <Label Text="Nome del gruppo" FontAttributes="Bold"/>
            <Entry x:Name="NomeEntry" Placeholder="es. Vacanza Roma 2025" />

            <Label Text="Password del gruppo" FontAttributes="Bold"/>
            <Entry x:Name="PasswordEntry" Placeholder="Almeno 6 caratteri" IsPassword="True"/>

            <Label Text="Valuta di riferimento" FontAttributes="Bold"/>
            <Picker x:Name="ValutaPicker" Title="Seleziona valuta">
                <Picker.Items>
                    <x:String>EUR</x:String>
                    <x:String>USD</x:String>
                    <x:String>GBP</x:String>
                    <x:String>CHF</x:String>
                </Picker.Items>
            </Picker>

            <Label x:Name="ErrorLabel" TextColor="#F87171" IsVisible="False"/>

            <Button x:Name="CreaBtn" Text="Crea Gruppo" BackgroundColor="#6E88ED"
                    TextColor="#0F172A" Clicked="OnCreaClicked" Margin="0,8,0,0"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
