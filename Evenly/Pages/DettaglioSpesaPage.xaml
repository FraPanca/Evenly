<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Evenly.Pages.DettaglioSpesaPage"
             BackgroundColor="{StaticResource PageBg}">

    <ScrollView>
        <VerticalStackLayout Padding="20,16" Spacing="14">

            <!-- Importo principale -->
            <Border BackgroundColor="#0B1422" Stroke="#1A3A78" StrokeShape="RoundRectangle 16"
                    Padding="20">
                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                    <Label x:Name="ImportoLabel" FontSize="38" FontAttributes="Bold"
                           TextColor="#6E88ED" HorizontalOptions="Center"/>
                    <Label x:Name="PaganteLabel" FontSize="14" TextColor="#8099B8"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>

            <!-- Dettagli spesa -->
            <Border BackgroundColor="#10192A" Stroke="#253550" StrokeShape="RoundRectangle 12"
                    Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,*" RowSpacing="10">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Data" FontSize="12" TextColor="#4A6480"/>
                            <Label x:Name="DataLabel" FontSize="14" FontAttributes="Bold"
                                   TextColor="#E8F0FE"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Metodo" FontSize="12" TextColor="#4A6480"/>
                            <Label x:Name="MetodoLabel" FontSize="14" FontAttributes="Bold"
                                   TextColor="#E8F0FE"/>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Note (visibile solo se presenti) -->
                    <VerticalStackLayout x:Name="NoteContainer" IsVisible="False" Spacing="2">
                        <BoxView HeightRequest="1" Color="#253550"/>
                        <Label Text="Note" FontSize="12" TextColor="#4A6480" Margin="0,4,0,0"/>
                        <Label x:Name="NoteLabel" FontSize="14" TextColor="#E8F0FE"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Divisione costi -->
            <Label Text="Divisione costi" FontSize="15" FontAttributes="Bold"
                   TextColor="#E8F0FE" Margin="0,4,0,0"/>

            <Border BackgroundColor="#10192A" Stroke="#253550" StrokeShape="RoundRectangle 12"
                    Padding="12,8">
                <CollectionView x:Name="QuoteCollection">
                    <CollectionView.EmptyView>
                        <Label Text="Nessuna quota disponibile." TextColor="#4A6480"
                               FontAttributes="Italic" Margin="4,8"/>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto" Padding="4,8">
                                <Label Text="{Binding Username}" FontSize="14" TextColor="#E8F0FE"
                                       VerticalOptions="Center"/>
                                <Label Grid.Column="1" FontSize="14" FontAttributes="Bold"
                                       TextColor="#6E88ED" VerticalOptions="Center">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Importo, StringFormat='{0:F2}'}"/>
                                            <Span Text=" €"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>

            <!-- Elimina spesa (solo per chi ha pagato) -->
            <Button x:Name="EliminaBtn" Text="Elimina spesa"
                    BackgroundColor="#DC2626" TextColor="White"
                    IsVisible="False" Clicked="OnEliminaClicked"
                    Margin="0,8,0,0"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
