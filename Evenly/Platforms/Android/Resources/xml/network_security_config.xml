<?xml version="1.0" encoding="utf-8"?>
<!--
    Configurazione sicurezza di rete per sviluppo.
    Permette HTTP cleartext verso il server di sviluppo.
    In produzione: rimuovere base-config e usare HTTPS.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Emulatore Android: 10.0.2.2 punta al localhost del PC -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- Dispositivo reale: aggiungere l'IP del PC (es. 192.168.1.X) -->
    </domain-config>
</network-security-config>
